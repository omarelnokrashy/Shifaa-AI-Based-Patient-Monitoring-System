# ============================================================
# .env.example — Medical Monitoring System
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Main backend ─────────────────────────────────────────────
DATABASE_URL=postgresql://medical_user:medical_pass_2025@localhost:5432/medical_db
SECRET_KEY=replace_with_a_long_random_secret_key_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── LLM backend (choose one) ─────────────────────────────────
# Option A: local Ollama
LLM_BACKEND=ollama
OLLAMA_MODEL=medgemma1.5:latest
OLLAMA_BASE_URL=http://localhost:11434

# Option B: OpenAI cloud
# LLM_BACKEND=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ── Inference service URLs ────────────────────────────────────
# These are the internal URLs the main backend uses to call the
# three AI microservices.  Change host/port if running on separate machines.
ARRHYTHMIA_SERVICE_URL=http://localhost:8001
FALL_DETECTION_SERVICE_URL=http://localhost:8002
SEIZURE_DETECTION_SERVICE_URL=http://localhost:8003

# ── Port overrides (used by start_all_services.sh) ───────────
MAIN_PORT=8000
ARRHYTHMIA_PORT=8001
FALL_DETECTION_PORT=8002
SEIZURE_DETECTION_PORT=8003
